<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Tickets</title>
    <!-- Bootstrap 5 CSS y Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <aside class="sidebar d-flex flex-column justify-content-between p-3">
            <div>

                <div class="text-center py-2 mb-2">
                    <img src="~/images/ABGLOGO.png" alt="Logo Empresa" class="img-fluid mb-2" style="max-height: 50px; width: auto;" />
                    <h6 class="fw-bold text-white text-uppercase tracking-wider m-0" style="font-size: 0.85rem; letter-spacing: 1px;">Admin Dashboard</h6>
                </div>

                <hr class="border-secondary opacity-25" />
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <!-- All Tickets -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-collection me-1"></i> Todos los Tickets
                        </a>
                    </li>

                    <!-- Pending Tickets -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Pendientes">
                            <i class="bi bi-clock-history me-1"></i> Pendientes
                        </a>
                    </li>

                    <!-- Mis Tickets -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="MisTickets">
                            <i class="bi bi-person-workspace me-2"></i> Mis Tickets
                        </a>
                    </li>

                    <!-- Resolved Tickets -->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Resueltos">
                            <i class="bi bi-check-circle me-1"></i> Resueltos
                        </a>
                    </li>

                    <!-- Configuracion-->
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Configuracion">
                            <i class="bi bi-gear me-2"></i> Configuración
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="CrearTicket">
                            <i class="bi bi-plus-circle me-1"></i> Nuevo Ticket
                        </a>

                    </li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-2">
                            <button type="submit" class="btn btn-lg text-danger btn-sm">
                                <i class="bi bi-box-arrow-right me-2"></i> Salir
                            </button>
                        </form>
                    </li>
                </ul>
                

               
            </div>
            <!-- Perfil en footer del sidebar -->
            <div class="d-flex align-items-center gap-2 p-2 rounded bg-dark">
                <img src="~/images/1177568.png" class="avatar-sm rounded-circle" alt="User" asp-append-version="true" />
                <div class="lh-1">
                    <small class="fw-bold d-block text-white">Leonardo C.</small>
                    <small class="text-lg-end" style="font-size: 11px;">Admin</small>

              
                </div>
            </div>
        </aside>

        <!-- Contenido Principal -->
        <main class="flex-grow-1 p-4" style="overflow-y: auto; max-height: 100vh;">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>