<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal de Soporte</title>
    <!-- Bootstrap 5 CSS y Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- Header / Navbar Superior para el Usuario -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="#">
                <i class="bi bi-headset text-primary fs-4"></i>
                <span>Portal de Soporte</span>
            </a>

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <!-- Enlace a Crear Ticket -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active fw-bold" : "")"
                       asp-controller="Tickets" asp-action="Create">
                        <i class="bi bi-plus-circle me-1"></i> Nuevo Ticket
                    </a>
                </li>

                <!-- Enlace a Mis Tickets -->
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active fw-bold" : "")"
                       asp-controller="Tickets" asp-action="Index">
                        <i class="bi bi-list-task me-1"></i> Mis Tickets
                    </a>
                </li>
            </ul>

            <!-- Sección derecha: Nombre de Usuario y Logout -->
            <div class="d-flex align-items-center gap-3">
                <span class="text-secondary small">
                    <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                </span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-light text-danger btn-sm border fw-semibold">
                        <i class="bi bi-box-arrow-right me-1"></i> Salir
                    </button>
                </form>
            </div>
            </div>
        </div>
    </nav>

    <!-- Contenido Principal -->
    <main class="py-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>