<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Portal de Soporte</title>
    <!-- Bootstrap 5 CSS y Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <!-- Navbar Superior -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="#">
                <img src="~/images/ABGLOGO.png" alt="Logo Empresa" class="img-fluid mb-0" style="max-height: 50px; width: auto;" />
                <span>Portal de Soporte</span>
            </a>
            <div class="d-flex align-items-center">
                <span class="text-light me-3 small">@User.Identity?.Name</span>
                <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-right"></i> Salir
                </a>
            </div>
        </div>
    </nav>

    <!-- Estructura Principal con Sidebar Lateral + Contenido -->
    <div class="container-fluid">
        <div class="row min-vh-100">

            <!-- SIDEBAR LATERAL IZQUIERDO -->
            <aside class="col-md-3 col-lg-2 bg-white border-end pt-4 px-3 d-flex flex-column justify-content-between shadow-sm">
                <div>
                    <!-- Foto y Perfil del Usuario -->
                    <div class="text-center mb-4">
                        <img src="@(string.IsNullOrEmpty(ViewBag.FotoPerfil) ? $"https://ui-avatars.com/api/?name={User.Identity?.Name}&background=0D6EFD&color=fff" : ViewBag.FotoPerfil)"
                             class="rounded-circle border shadow-sm mb-3"
                             alt="Foto de perfil"
                             width="120" height="120" style="object-fit: cover;" />

                        <h6 class="fw-bold mb-0 text-dark">@User.Identity?.Name</h6>
                        <small class="text-muted d-block">@(ViewBag.Departamento ?? "General")</small>
                    </div>

                    <hr class="my-3 text-muted" />

                    <!-- Menú de Navegación Lateral Con Mayor Tamaño y Espaciado -->
                    <ul class="nav nav-pills flex-column gap-2">
                        <li class="nav-item">
                            <a class="nav-link fs-6 py-2 px-3 text-dark @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active text-white fw-bold" : "")"
                               asp-controller="Tickets" asp-action="Create">
                                <i class="bi bi-plus-circle me-2 fs-5 align-middle"></i> Nuevo Ticket
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link fs-6 py-2 px-3 text-dark @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active text-white fw-bold" : "")"
                               asp-controller="Tickets" asp-action="Index">
                                <i class="bi bi-list-task me-2 fs-5 align-middle"></i> Mis Tickets
                            </a>
                        </li>

                        <!-- Opción de Configuración  -->
                        <li class="nav-item">
                            <a class="nav-link fs-6 py-2 px-3 text-dark @(ViewContext.RouteData.Values["action"]?.ToString() == "Perfil" ? "active text-white fw-bold" : "")"
                               asp-controller="Tickets" asp-action="ConfiguracionUser">
                                <i class="bi bi-gear me-2 fs-5 align-middle"></i> Configuración
                            </a>
                        </li>
                    </ul>
                </div>

               
            </aside>

            <!-- CONTENIDO PRINCIPAL DE LA VISTA -->
            <main class="col-md-9 col-lg-10 bg-light p-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>