@{
    Layout = "_LayoutUser";
    ViewData["Title"] = "Configuración de Perfil";
}

<div class="container-fluid max-w-750 py-3">
    <!-- Encabezado de la sección -->
    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-gear me-2"></i>Configuración del Perfil
        </h3>
        <p class="text-muted small">Actualiza tu foto, departamento y contraseña</p>
    </div>

    <!-- Alertas TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-controller="Tickets" asp-action="ActualizarPerfilUser" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- Visualización y cargar foto -->
                <div class="mb-4 text-center">
                    <div class="position-relative d-inline-block">
                        <img src="@(string.IsNullOrEmpty(ViewBag.FotoPerfil) ? $"https://ui-avatars.com/api/?name={User.Identity?.Name}&background=0D6EFD&color=fff" : ViewBag.FotoPerfil)"
                             class="rounded-circle border shadow-sm mb-3"
                             alt="Foto de perfil"
                             width="120" height="120" style="object-fit: cover;" />
                    </div>
                    <div class="col-md-6 mx-auto">
                        <label class="form-label fw-bold small text-secondary">Cambiar foto de perfil</label>
                        <input type="file" name="foto" class="form-control form-control-sm" accept="image/*" />
                    </div>
                </div>

                <hr class="my-4 text-muted" />

                <!-- Datos del usuario -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <input type="text" name="nombre" value="@User.Identity?.Name" class="form-control" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Departamento/Área</label>
                        <input type="text" name="departamento" value="@ViewBag.Departamento" class="form-control" required />
                    </div>
                </div>

                <hr class="my-4 text-muted" />

                <!-- Cambiar contraseña -->
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-shield-lock me-2"></i>Seguridad
                </h6>

                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label small text-secondary">Nueva contraseña (dejar en blanco para mantener la actual)</label>
                        <input type="password" name="nuevaPassword" class="form-control" placeholder="**********" />
                    </div>
                </div>

                <!-- Botón de guardado -->
                <div class="d-flex justify-content-end gap-2 mt-4 pt-2">
                    <button type="submit" class="btn btn-primary fw-bold px-4">
                        <i class="bi bi-floppy me-1"></i>Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>