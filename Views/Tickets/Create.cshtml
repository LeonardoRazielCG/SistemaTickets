@model SistemaTickets.Models.Ticket

@{
    Layout = "_LayoutUser";
    ViewData["Title"] = "Crear Nuevo Ticket";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="mb-4">
                <h3 class="fw-bold text-dark m-0">Generar Solicitud de Soporte</h3>
                <p class="text-secondary">Describe tu problema detalladamente para que el equipo de sistemas pueda ayudarte.</p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <form asp-controller="Tickets" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Título -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Asunto / Título del Problema <span class="text-danger">*</span></label>
                        <input asp-for="Titulo" class="form-control form-control-lg" placeholder="Ej. Error al timbrar nómina" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Categoría -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Categoría / Área <span class="text-danger">*</span></label>
                            <select asp-for="Categoria" class="form-select" required>
                                <option value="" selected disabled>Selecciona una opción...</option>
                                <option value="OLIN">OLIN (Timbrados, Cancelación, Retimbrados, Accesos)</option>
                                <option value="Tress">Sistema Tress</option>
                                <option value="Kiosko">Kiosko (CURP, Actualizaciones)</option>
                                <option value="Red / VPN">Red / VPN (Conexión y Acceso)</option>
                            </select>
                        </div>

                        <!-- Urgencia / Prioridad -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-dark">Urgencia</label>
                            <select asp-for="Prioridad" class="form-select">
                                <option value="Baja">Baja - Puedo seguir trabajando</option>
                                <option value="Media" selected>Media - Dificulta mi trabajo</option>
                                <option value="Alta">Alta - Bloqueo total de labores</option>
                            </select>
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Descripción detallada <span class="text-danger">*</span></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="5" placeholder="Escribe aquí los detalles del problema..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-end align-items-center gap-3 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light px-4 fw-bold">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold rounded-pill">
                            <i class="bi bi-send-fill me-2"></i>Enviar Ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>