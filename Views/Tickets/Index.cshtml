@model IEnumerable<SistemaTickets.Models.Ticket>

@{
    Layout = "_LayoutUser";
    ViewData["Title"] = "Mis Tickets";
}

<div class="container py-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0">Mis Solicitudes de Soporte</h3>
            <p class="text-secondary small m-0">Revisa el estado de los tickets que has enviado</p>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Ticket
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Asunto</th>
                        <th>Categoría</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No has registrado ninguna solicitud aún.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@item.Id</td>
                                <td class="fw-semibold">@item.Titulo</td>
                                <td><span class="badge bg-light text-dark border">@item.Categoria</span></td>
                                <td>
                                    @if (item.Prioridad == "Alta")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Alta</span>
                                    }
                                    else if (item.Prioridad == "Media")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Media</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">Baja</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge rounded-pill bg-primary">@item.Estado</span>
                                </td>
                                <td class="text-secondary small">@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>