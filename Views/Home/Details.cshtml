@model SistemaTickets.Models.Ticket

@{
    Layout = "_Layout";
    ViewData["Title"] = $"Gestión de Ticket #{Model.Id}";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
                <i class="bi bi-arrow-left"></i> Volver al Dashboard
            </a>
            <h3 class="fw-bold m-0">Ticket #@Model.Id - @Model.Titulo</h3>
            <small class="text-muted">Creado el @Model.FechaCreacion.ToString("f") por <strong>@Model.UsuarioEmail</strong></small>
        </div>
        <span class="badge fs-6 bg-@(Model.Estado == "Abierto" ? "danger" : Model.Estado == "En Proceso" ? "warning" : "success")">
            @Model.Estado
        </span>
    </div>

    <div class="row g-4">
        <!-- Panel Izquierdo: Información y Comentarios -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3">Descripción de la Solicitud</h5>
                <p class="text-secondary mb-0">@Model.Descripcion</p>
            </div>

            <!-- Sección de Comentarios / Timeline -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-chat-left-dots me-2"></i>Historial de Respuestas (@Model.Comentarios.Count)</h5>

                <div class="mb-4">
                    @foreach (var c in Model.Comentarios)
                    {
                        <div class="border-start border-3 border-primary ps-3 mb-3 bg-light p-3 rounded-3">
                            <div class="d-flex justify-content-between text-muted small mb-1">
                                <strong>@c.Autor</strong>
                                <span>@c.Fecha.ToString("g")</span>
                            </div>
                            <p class="m-0 text-dark">@c.Texto</p>
                        </div>
                    }
                    @if (!Model.Comentarios.Any())
                    {
                        <p class="text-muted small">No hay comentarios en este ticket aún.</p>
                    }
                </div>

                <!-- Formulario Agregar Comentario -->
                <form asp-action="AddComment" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <textarea name="textoComentario" class="form-control" rows="3" placeholder="Escribe un comentario o actualización técnica..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-send me-1"></i> Responder
                    </button>
                </form>
            </div>
        </div>

        <!-- Panel Derecho: Controles de Gestión (Panel de Control) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- Encabezado con Fondo Azul Completo y Texto Blanco -->
                <div class="card-header bg-primary text-white py-3 px-4 border-0">
                    <h5 class="fw-bold m-0">Panel de Control</h5>
                </div>

                <!-- Cuerpo de la Tarjeta con el Formulario -->
                <div class="card-body p-4">
                    <form asp-action="UpdateStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <!-- Cambio de Estado -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Estado del Ticket</label>
                            <select name="nuevoEstado" class="form-select">
                                <option value="Abierto" selected="@(Model.Estado == "Abierto")">Abierto</option>
                                <option value="En Proceso" selected="@(Model.Estado == "En Proceso")">En Proceso</option>
                                <option value="Resuelto" selected="@(Model.Estado == "Resuelto")">Resuelto</option>
                                <option value="Cerrado" selected="@(Model.Estado == "Cerrado")">Cerrado</option>
                            </select>
                        </div>

                        <!-- Asignación / Lista Dinámica de Encargados (TI) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Asignado a</label>
                            <select name="asignadoA" class="form-select">
                                <option value="Sin asignar">Sin asignar</option>
                                @if (ViewBag.Tecnicos != null)
                                {
                                    foreach (var admin in (List<SistemaTickets.Models.Usuario>)ViewBag.Tecnicos)
                                    {
                                        <option value="@admin.Nombre" selected="@(Model.AsignadoA == admin.Nombre ? "selected" : null)">
                                            @admin.Nombre
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <form asp-controller="Home" asp-action="AsignarAMi" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-primary fw-bold">
                                <i class="bi bi-person-check me-1"></i> Asignarme a mí
                            </button>
                        </form>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success fw-bold rounded-pill">
                                <i class="bi bi-check2-circle me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>