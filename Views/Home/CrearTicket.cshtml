@model SistemaTickets.Models.Ticket

@{
    Layout = "_Layout";
    ViewData["Title"] = "Crear Ticket de Soporte";
}

<div class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h3 class="fw-bold m-0">Registrar Nuevo Ticket</h3>
                    <small class="text-muted">Creación manual de ticket desde el panel de administración</small>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Regresar al Dashboard
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <form asp-controller="Home" asp-action="CrearTicket" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Asunto -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Asunto / Título del Problema <span class="text-danger">*</span></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej. Falla en servidor de licencias" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Categoría -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Categoría / Área <span class="text-danger">*</span></label>
                            <select asp-for="Categoria" class="form-select" required>
                                <option value="" selected disabled>Selecciona una opción...</option>
                                <option value="OLIN">OLIN (Timbrados, Cancelación, Retimbrados, Accesos)</option>
                                <option value="Tress">Sistema Tress</option>
                                <option value="Kiosko">Kiosko (CURP, Actualizaciones)</option>
                                <option value="Red / VPN">Red / VPN (Conexión y Acceso)</option>
                            </select>
                        </div>

                        <!-- Prioridad -->
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Prioridad</label>
                            <select asp-for="Prioridad" class="form-select">
                                <option value="Baja">Baja</option>
                                <option value="Media" selected>Media</option>
                                <option value="Alta">Alta</option>
                            </select>
                        </div>
                    </div>

                    <!-- Descripción -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción detallada <span class="text-danger">*</span></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Escribe el reporte técnico o solicitud..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light fw-bold px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4">
                            <i class="bi bi-plus-circle me-1"></i> Crear Ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>