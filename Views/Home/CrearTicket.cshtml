@{
    ViewData["Title"] = "Crear Nuevo Ticket";
}

<div class="container-fluid max-width-1000 mx-auto">
    <!-- Encabezado -->
    <div class="top-header mb-4 d-flex align-items-center justify-content-between">
        <div>
            <h4 class="m-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Crear Nuevo Ticket</h4>
            <small class="text-white-50">Llena la información detallada para que el equipo de TI pueda atenderte.</small>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light btn-sm fw-bold">
            <i class="bi bi-arrow-left me-1"></i> Volver a Mis Tickets
        </a>
    </div>

    <!-- Tarjeta Principal del Formulario -->
    <div class="card-custom p-4 shadow-sm">
        <form asp-action="CrearTicket" method="post" enctype="multipart/form-data">

            <div class="row g-3">
                <!-- Título del Ticket -->
                <div class="col-12">
                    <label class="form-label fw-bold text-dark">Asunto o Título Corto <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-lg" placeholder="Ej. Error en timbrado de nómina / Falla en impresora de almacén" required />
                </div>

                <!-- Categoría / Área -->
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Categoría o Departamento <span class="text-danger">*</span></label>
                    <select class="form-select" required>
                        <option value="" selected disabled>Selecciona una opción...</option>
                        <option value="Sistemas">Sistemas / Software / ERP</option>
                        <option value="Redes">Redes e Internet</option>
                        <option value="Hardware">Hardware / Equipos de Cómputo</option>
                       
                    </select>
                </div>

                <!-- Prioridad Estimada -->
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Urgencia / Impacto <span class="text-danger">*</span></label>
                    <select class="form-select" required>
                        <option value="Baja">Baja - No impide mis labores diarias</option>
                        <option value="Media" selected>Media - Afecta un proceso secundario</option>
                        <option value="Alta">Alta - Bloqueo total de mis actividades</option>
                    </select>
                </div>

                <!-- Descripción Detallada -->
                <div class="col-12">
                    <label class="form-label fw-bold text-dark">Descripción Detallada del Problema <span class="text-danger">*</span></label>
                    <textarea class="form-control" rows="5" placeholder="Por favor detalla los pasos para reproducir el problema, mensajes de error que aparecen o cualquier detalle relevante..." required></textarea>
                </div>

                <!-- Carga de Archivos / Capturas -->
                <div class="col-12">
                    <label class="form-label fw-bold text-dark">Adjuntar Archivos o Capturas de Pantalla</label>
                    <div class="border border-2 border-dashed rounded-3 p-4 text-center bg-light">
                        <i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>
                        <p class="mb-1 fw-bold text-secondary">Arrastra tus archivos aquí o haz clic para examinar</p>
                        <small class="text-muted d-block mb-3">Formatos permitidos: PNG, JPG, PDF, TXT, LOG (Máx. 10MB por archivo)</small>
                        <input type="file" class="form-control d-none" id="fileUpload" multiple />
                        <button type="button" class="btn btn-outline-primary btn-sm fw-bold" onclick="document.getElementById('fileUpload').click();">
                            <i class="bi bi-folder2-open me-1"></i> Seleccionar Archivos
                        </button>
                    </div>
                </div>

                <!-- Botones de Acción -->
                <div class="col-12 d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-light border fw-bold px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary fw-bold px-5">
                        <i class="bi bi-send me-1"></i> Enviar Ticket
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>