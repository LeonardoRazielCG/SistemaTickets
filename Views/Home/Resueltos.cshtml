@model IEnumerable<SistemaTickets.Models.Ticket>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Tickets Resueltos";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold m-0 text-dark">Tickets Resueltos / Finalizados</h3>
            <small class="text-muted">Histórico de atenciones completadas exitosamente</small>
        </div>
        <span class="badge bg-success text-white fs-6 px-3 py-2 rounded-pill">
            <i class="bi bi-check-circle-fill me-1"></i> @Model.Count() Resuelto(s)
        </span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Usuario</th>
                            <th>Asunto</th>
                            <th>Categoría</th>
                            <th>Estado</th>
                            <th>Atendido Por</th>
                            <th>Fecha</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">#@ticket.Id</td>
                                <td>
                                    <span class="d-block fw-semibold text-dark">@ticket.UsuarioEmail</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@ticket.Titulo</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@ticket.Categoria</span>
                                </td>
                                <td>
                                    <span class="badge bg-success">
                                        <i class="bi bi-check2-all me-1"></i>@ticket.Estado
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted">@(string.IsNullOrEmpty(ticket.AsignadoA) ? "Sistema" : ticket.AsignadoA)</small>
                                </td>
                                <td>
                                    <small class="text-muted">@ticket.FechaCreacion.ToString("g")</small>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                                        <i class="bi bi-eye-fill me-1"></i> Ver Detalle
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                    Aún no hay tickets marcados como resueltos.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>