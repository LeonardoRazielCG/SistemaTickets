@model IEnumerable<SistemaTickets.Models.Usuario>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Configuración del Sistema";

    var usuarioActual = ViewBag.UsuarioActual as SistemaTickets.Models.Usuario;
    string fotoPerfilPath = !string.IsNullOrEmpty(usuarioActual?.FotoPerfilUrl)
        ? usuarioActual.FotoPerfilUrl
        : null;
}

<div class="container-fluid py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold m-0">Centro de Configuración</h3>
            <small class="text-muted">Administración general de usuarios, catálogos y parámetros del sistema</small>
        </div>
    </div>

    <!-- Mensajes TempData -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Pestañas -->
    <ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-4 shadow-sm" id="configTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill fw-bold" id="usuarios-tab" data-bs-toggle="pill" data-bs-target="#usuarios" type="button" role="tab">
                <i class="bi bi-people me-2"></i>Gestión de Usuarios
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="catalogos-tab" data-bs-toggle="pill" data-bs-target="#catalogos" type="button" role="tab">
                <i class="bi bi-tags me-2"></i>Catálogos
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="smtp-tab" data-bs-toggle="pill" data-bs-target="#smtp" type="button" role="tab">
                <i class="bi bi-envelope-at me-2"></i>Notificaciones SMTP
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold" id="firma-tab" data-bs-toggle="pill" data-bs-target="#firma" type="button" role="tab">
                <i class="bi bi-card-heading me-2"></i>Firma y Perfil Admin
            </button>
        </li>
    </ul>

    <div class="tab-content" id="configTabsContent">
        <!-- 1. GESTIÓN DE USUARIOS -->
        <div class="tab-pane fade show active" id="usuarios" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h5 class="fw-bold mb-3"><i class="bi bi-person-plus me-2 text-primary"></i>Nuevo Usuario</h5>
                        <form asp-controller="Usuarios" asp-action="Crear" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-bold">Número de Nómina</label>
                                <input type="number" name="Nomina" class="form-control" placeholder="Ej. 1002" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nombre Completo</label>
                                <input type="text" name="Nombre" class="form-control" placeholder="Ej. Carlos Mendoza" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Correo Electrónico</label>
                                <input type="email" name="Correo" class="form-control" placeholder="usuario@empresa.com" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Departamento</label>
                                <select name="Departamento" class="form-select" required>
                                    <option value="Sistemas">Sistemas / TI</option>
                                    <option value="Recursos Humanos">Recursos Humanos</option>
                                    <option value="Contabilidad">Contabilidad</option>
                                    <option value="Nóminas">Nóminas</option>
                                    <option value="Operaciones">Operaciones</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Rol en el Sistema</label>
                                <select name="Rol" class="form-select" required>
                                    <option value="Usuario">Usuario Solicitante</option>
                                    <option value="Admin">Administrador / TI</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 fw-bold rounded-pill">
                                Registrar Usuario
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h5 class="fw-bold mb-3">Usuarios Registrados</h5>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nómina</th>
                                        <th>Usuario</th>
                                        <th>Departamento</th>
                                        <th>Rol</th>
                                        <th>Estatus</th>
                                        <th class="text-end">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Any())
                                    {
                                        @foreach (var u in Model)
                                        {
                                            <tr>
                                                <td class="fw-bold text-secondary">#@u.Nomina</td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        @if (!string.IsNullOrEmpty(u.FotoPerfilUrl))
                                                        {
                                                            <img src="@u.FotoPerfilUrl" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-person-circle fs-4 text-secondary"></i>
                                                        }
                                                        <div>
                                                            <div class="fw-bold">@u.Nombre</div>
                                                            <small class="text-muted">@u.Correo</small>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>@u.Departamento</td>
                                                <td>
                                                    <span class="badge @(u.Rol == "Admin" ? "bg-primary" : "bg-secondary")">
                                                        @u.Rol
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge @(u.Estatus == "Activo" ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">
                                                        @u.Estatus
                                                    </span>
                                                </td>

                                                <td class="text-end">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary border-0 btn-editar-user"
                                                            data-id="@u.Id"
                                                            data-nombre="@u.Nombre"
                                                            data-departamento="@u.Departamento"
                                                            data-rol="@u.Rol"
                                                            data-nomina="@u.Nomina"
                                                            data-correo="@u.Correo"
                                                            data-estatus="@u.Estatus"
                                                            title="Modificar usuario">
                                                        <i class="bi bi-pencil"></i>
                                                        </button>                                                    
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-3">No hay usuarios registrados en la base de datos.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. CATÁLOGOS DEL SISTEMA -->
        <div class="tab-pane fade" id="catalogos" role="tabpanel">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h5 class="fw-bold mb-3"><i class="bi bi-tags me-2 text-primary"></i>Categorías de Tickets</h5>

                        <form asp-controller="Home" asp-action="CrearCategoria" method="post" class="mb-4">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-bold small">Nombre de la Categoría</label>
                                <input type="text" name="nombreCategoria" class="form-control" placeholder="Ej: Impresoras / Redes / SUA" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold small">Descripción (Opcional)</label>
                                <input type="text" name="descripcionCategoria" class="form-control" placeholder="Ej: Incidencias relacionadas con equipos de impresión" />
                            </div>
                            <button class="btn btn-primary fw-bold rounded-pill" type="submit">
                                <i class="bi bi-plus-circle me-1"></i> Agregar Categoría
                            </button>
                        </form>

                        <h6 class="fw-bold text-secondary mt-4">Categorías Existentes</h6>
                        <hr />

                        <div class="list-group list-group-flush">
                            @if (ViewBag.Categorias != null && ((List<SistemaTickets.Models.Categoria>)ViewBag.Categorias).Any())
                            {
                                foreach (var cat in (List<SistemaTickets.Models.Categoria>)ViewBag.Categorias)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0">
                                        <div>
                                            <span class="fw-bold d-block text-dark">@cat.Nombre</span>
                                            @if (!string.IsNullOrEmpty(cat.Descripcion))
                                            {
                                                <small class="text-muted d-block">@cat.Descripcion</small>
                                            }
                                        </div>
                                        <form asp-controller="Home" asp-action="EliminarCategoria" asp-route-id="@cat.Id" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar la categoría @cat.Nombre?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small">No hay categorías registradas.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. PARÁMETROS SMTP -->
        <div class="tab-pane fade" id="smtp" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white col-lg-8">
                <h5 class="fw-bold mb-3"><i class="bi bi-gear-wide-connected me-2 text-primary"></i>Configuración de Servidor de Correo (SMTP)</h5>
                <form asp-controller="Home" asp-action="GuardarSMTP" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Servidor SMTP</label>
                            <input type="text" name="SmtpServer" class="form-control" placeholder="smtp.office365.com o smtp.gmail.com" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Puerto</label>
                            <input type="number" name="Port" class="form-control" placeholder="587" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Correo Emisor</label>
                            <input type="email" name="SenderEmail" class="form-control" placeholder="soporte@empresa.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Contraseña / Password de Aplicación</label>
                            <input type="password" name="SenderPassword" class="form-control" placeholder="••••••••••••" />
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4">Guardar Cambios</button>
                        <button type="button" class="btn btn-outline-secondary fw-bold rounded-pill">Probar Conexión</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- 4. FIRMA Y PERFIL DE ADMINISTRADOR -->
        <div class="tab-pane fade" id="firma" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white text-center">
                        <h5 class="fw-bold mb-3">Foto de Perfil</h5>
                        <div class="mb-3 d-flex justify-content-center">
                            @if (!string.IsNullOrEmpty(fotoPerfilPath))
                            {
                                <img src="@fotoPerfilPath" class="rounded-circle img-thumbnail shadow-sm" style="width: 130px; height: 130px; object-fit: cover;" id="previewFoto" alt="Foto de Perfil" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center shadow-sm border" style="width: 130px; height: 130px;">
                                    <i class="bi bi-person-fill text-secondary display-4"></i>
                                </div>
                            }
                        </div>
                        <form asp-controller="Home" asp-action="ActualizarFotoPerfil" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="file" name="foto" class="form-control mb-3" accept="image/*" required />
                            <button type="submit" class="btn btn-outline-primary fw-bold rounded-pill w-100">
                                <i class="bi bi-upload me-1"></i> Subir Nueva Foto
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                        <h5 class="fw-bold mb-3">Firma Automática para Respuestas y Correos</h5>
                        <form asp-controller="Home" asp-action="GuardarFirma" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-bold">Texto / Plantilla de Cierre</label>
                                <textarea name="FirmaTexto" class="form-control" rows="5" placeholder="Atentamente,&#10;Departamento de Tecnologías de la Información"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4">Guardar Firma</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODALES -->
<!-- Modal Editar Usuario -->
<div class="modal fade" id="modalGestionUsuario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">

            <div class="modal-header border-bottom-0 pb-0">
                <div>
                    <h5 class="modal-title fw-bold" id="gestionModalTitle">Gestionar Usuario</h5>
                    <small class="text-muted">Modifica la información general, credenciales, estatus o elimina la cuenta.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-3">
                <!-- Pestañas Internas del Modal -->
                <ul class="nav nav-tabs border-0 mb-3 gap-2" id="userModalTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold rounded-pill" id="tab-info-tab" data-bs-toggle="tab" data-bs-target="#tab-info" type="button" role="tab">
                            <i class="bi bi-person-gear me-1"></i> Información General
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold rounded-pill text-warning" id="tab-security-tab" data-bs-toggle="tab" data-bs-target="#tab-security" type="button" role="tab">
                            <i class="bi bi-key me-1"></i> Contraseña
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold rounded-pill text-danger" id="tab-danger-tab" data-bs-toggle="tab" data-bs-target="#tab-danger" type="button" role="tab">
                            <i class="bi bi-shield-exclamation me-1"></i> Estado y Borrado
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="userModalTabsContent">
                    <!-- PESTAÑA 1: DATOS GENERALES -->
                    <div class="tab-pane fade show active" id="tab-info" role="tabpanel">
                        <form asp-controller="Usuarios" asp-action="Editar" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="gestionUserId" name="id" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Número de Nómina</label>
                                    <input type="number" id="gestionNomina" name="nomina" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Nombre Completo</label>
                                    <input type="text" id="gestionNombre" name="nombre" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Correo Electrónico</label>
                                    <input type="email" id="gestionCorreo" name="correo" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small">Departamento</label>
                                    <select id="gestionDepartamento" name="departamento" class="form-select" required>
                                        <option value="Sistemas">Sistemas / TI</option>
                                        <option value="Recursos Humanos">Recursos Humanos</option>
                                        <option value="Contabilidad">Contabilidad</option>
                                        <option value="Nóminas">Nóminas</option>
                                        <option value="Operaciones">Operaciones</option>
                                    </select>
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold small">Rol en el Sistema</label>
                                    <select id="gestionRol" name="rol" class="form-select" required>
                                        <option value="Usuario">Usuario Solicitante</option>
                                        <option value="Admin">Administrador / TI</option>
                                    </select>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary rounded-pill fw-bold">Guardar Cambios</button>
                            </div>
                        </form>
                    </div>

                    <!-- PESTAÑA 2: CONTRASEÑA -->
                    <div class="tab-pane fade" id="tab-security" role="tabpanel">
                        <form asp-controller="Usuarios" asp-action="CambiarContrasena" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" id="gestionUserIdPass" name="id" />

                            <div class="p-3 bg-light rounded-4 mb-3">
                                <label class="form-label fw-bold small">Nueva Contraseña</label>
                                <input type="password" name="nuevaContrasena" class="form-control mb-2" placeholder="••••••••" required />
                                <small class="text-muted">Asigna una nueva contraseña de acceso para este usuario.</small>
                            </div>

                            <div class="d-flex justify-content-end gap-2">
                                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-warning rounded-pill fw-bold">Actualizar Contraseña</button>
                            </div>
                        </form>
                    </div>

                    <!-- PESTAÑA 3: ESTATUS Y BORRADO -->
                    <div class="tab-pane fade" id="tab-danger" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="p-3 border rounded-4 d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="fw-bold mb-1">Estatus de la Cuenta</h6>
                                        <small class="text-muted">Estatus actual: <strong id="gestionEstatusTexto" class="text-dark">Activo</strong></small>
                                    </div>
                                    <form asp-controller="Usuarios" asp-action="CambiarEstatus" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" id="gestionUserIdEstatus" name="id" />
                                        <button type="submit" class="btn btn-outline-info rounded-pill fw-bold">
                                            Cambiar Estatus
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="p-3 border border-danger-subtle bg-danger-subtle bg-opacity-10 rounded-4 d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="fw-bold text-danger mb-1">Eliminar Usuario</h6>
                                        <small class="text-muted">Si el usuario tiene tickets asociados, la base de datos impedirá el borrado para proteger el historial.</small>
                                    </div>
                                    <form asp-controller="Usuarios" asp-action="EliminarDefinitivo" method="post" onsubmit="return confirm('¿Seguro que deseas eliminar permanentemente a este usuario?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" id="gestionUserIdDelete" name="id" />
                                        <button type="submit" class="btn btn-danger rounded-pill fw-bold">
                                            <i class="bi bi-trash me-1"></i> Eliminar
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- ================= JAVASCRIPT DE INTEGRACIÓN ================= -->
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Escuchar clics en todos los botones con la clase .btn-editar-user
            document.querySelectorAll('.btn-editar-user').forEach(function (button) {
                button.addEventListener('click', function () {
                    // Extraer los datos desde los atributos HTML data-*
                    var id = this.getAttribute('data-id');
                    var nombre = this.getAttribute('data-nombre');
                    var departamento = this.getAttribute('data-departamento');
                    var rol = this.getAttribute('data-rol');
                    var nomina = this.getAttribute('data-nomina');
                    var correo = this.getAttribute('data-correo');
                    var estatus = this.getAttribute('data-estatus');

                    // Asignar el ID a los formularios dentro del modal
                    if (document.getElementById('gestionUserId')) document.getElementById('gestionUserId').value = id;
                    if (document.getElementById('gestionUserIdPass')) document.getElementById('gestionUserIdPass').value = id;
                    if (document.getElementById('gestionUserIdEstatus')) document.getElementById('gestionUserIdEstatus').value = id;
                    if (document.getElementById('gestionUserIdDelete')) document.getElementById('gestionUserIdDelete').value = id;

                    // Poblar campos de texto
                    if (document.getElementById('gestionNomina')) document.getElementById('gestionNomina').value = nomina;
                    if (document.getElementById('gestionNombre')) document.getElementById('gestionNombre').value = nombre;
                    if (document.getElementById('gestionCorreo')) document.getElementById('gestionCorreo').value = correo;
                    if (document.getElementById('gestionDepartamento')) document.getElementById('gestionDepartamento').value = departamento;
                    if (document.getElementById('gestionRol')) document.getElementById('gestionRol').value = rol;

                    // Textos del encabezado
                    if (document.getElementById('gestionModalTitle')) document.getElementById('gestionModalTitle').innerText = 'Modificar: ' + nombre;
                    if (document.getElementById('gestionEstatusTexto')) document.getElementById('gestionEstatusTexto').innerText = estatus;

                    // Activar la primera pestaña ("Información General")
                    var firstTabEl = document.getElementById('tab-info-tab');
                    if (firstTabEl) {
                        var firstTab = new bootstrap.Tab(firstTabEl);
                        firstTab.show();
                    }

                    // Abrir el Modal de Bootstrap
                    var modalEl = document.getElementById('modalGestionUsuario');
                    if (modalEl) {
                        var modal = new bootstrap.Modal(modalEl);
                        modal.show();
                    } else {
                        console.error("No se encontró el elemento modal con ID 'modalGestionUsuario'");
                    }
                });
